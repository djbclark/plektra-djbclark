# Copy to qa/.env. just loads it. Point FIRERPA_CERT at the installer's lamda.pem.
FIRERPA_HOST=127.0.0.1
FIRERPA_PORT=65000
FIRERPA_CERT=/absolute/path/to/lamda.pem
FIRERPA_VERSION=10.12
# Required for a guided run. Use a transport ID listed by adb devices.
ADB_TARGET=
# Application ID of the active debuggable Plektra build. Uncomment to override.
# PLEKTRA_QA_PACKAGE=rocks.pkb.plektra.djb
