# FIRERPA HITL harness. Run from this directory.
# FIRERPA_CERT is the lamda.pem from the standalone installer. Never commit it.

set dotenv-load
set shell := ["bash", "-uc"]

FIRERPA_VERSION := env_var_or_default("FIRERPA_VERSION", "10.12")

default:
    @just --list

# Prove the certificate-authenticated gRPC channel and the expected version.
qa-connect:
    cd "{{ justfile_directory() }}" && uv run --python 3.14 plektra-qa connect

# Zero animator duration and enable the UI watcher loop.
qa-prep:
    cd "{{ justfile_directory() }}" && uv run --python 3.14 plektra-qa prep

# Run one YAML suite. The human chords; this process only watches the field.
# The run is recorded by default (screen, spoken prompts and every key, as an mp4): tell the person first.
# Add --no-record to turn it off; the start card also offers that (No rec on the bar, norec in the terminal).
qa-run suite *flags:
    cd "{{ justfile_directory() }}" && uv run --python 3.14 plektra-qa run "{{ suite }}" {{ flags }}

# Print the screen, shade and spoken versions of key tokens, e.g. just qa-keys "<Ctrl+A>, then <Ctrl+C>".
# Live keymap from the phone when ADB_TARGET is set, else the profile.
qa-keys text:
    cd "{{ justfile_directory() }}" && uv run --python 3.14 plektra-qa render {{ quote(text) }}

# Register the proven dialog watchers (no settings change); prints whether each dialog is still showing.
qa-watchers:
    cd "{{ justfile_directory() }}" && uv run --python 3.14 plektra-qa watchers

# Print the foreground app and the screen's nodes; --click RESOURCE_ID clicks first. Debugs "input field not found".
qa-ui *flags:
    cd "{{ justfile_directory() }}" && uv run --python 3.14 plektra-qa ui {{ flags }}

# MCP server on stdio for an agent session.
qa-mcp:
    cd "{{ justfile_directory() }}" && uv run --python 3.14 plektra-qa mcp
