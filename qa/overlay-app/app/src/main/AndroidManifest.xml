<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission: draw over other apps. No network, no storage. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- To name the keyboard in use and its version on the test bench. -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="HITL button bar"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Explains the app and opens the "draw over other apps" screen. Nothing else. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The test bench: text boxes of several kinds and a panel of what happens in them. Holds no
          data. Keyboard configuration changes do not restart it. Its intent extras rewrite the boxes,
          so from outside only the adb shell user (DUMP) can start it; the app's own button also can.
        -->
        <activity
            android:name=".BenchActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|touchscreen"
            android:exported="true"
            android:label="QA test bench"
            android:launchMode="singleTask"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Exported so that `adb shell am broadcast` can reach it, but only senders that hold
          android.permission.DUMP (the adb shell user; no normal app can get it) are delivered.
        -->
        <receiver
            android:name=".BarReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.hitlbar.overlay.SHOW" />
                <action android:name="dev.hitlbar.overlay.HIDE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
