#!/usr/bin/env bash
# djb-install-latest — install a "Plektra djb" release from forgejo.mit.edu on the phone.
#
#   scripts/djb-install-latest          # newest release
#   scripts/djb-install-latest TAG      # a given release, e.g. djb-20261014.1802-da27a141
#
# Fork-only (plk/base). Releases come from .forgejo/workflows/djb-main.yml (every push to
# plk/main). The device is $ANDROID_SERIAL, or the one adb device that already has
# rocks.pkb.plektra.djb. The APK is checked against its .sha256 asset, then installed with
# `adb install -r` (keeps app data). The installed tag is recorded in
# ~/.local/state/plektra-djb/installed-<serial>.
set -euo pipefail

repo=djbclark/plektra-djbclark
pkg=rocks.pkb.plektra.djb
api="${FORGEJO_SCRIPTS:-$HOME/src/djbclark-ade/skills/forgejo/scripts}/forgejo-api"
var=DJBCLARK_FORGEJO_MIT_EDU_TOKEN

# One sudo-secretspec session for every API call below.
if [ -z "${!var:-}" ] && [ -z "${DJB_INSTALL_REEXEC:-}" ]; then
  DJB_INSTALL_REEXEC=1 exec sudo-secretspec run --reason "download a Plektra djb release" -- "$0" "$@"
fi

if [ -n "${ANDROID_SERIAL:-}" ]; then
  serial=$ANDROID_SERIAL
else
  candidates=()
  for s in $(adb devices | gawk 'NR > 1 && $2 == "device" { print $1 }'); do
    if adb -s "$s" shell pm list packages "$pkg" 2>/dev/null | tr -d '\r' | grep -qx "package:$pkg"; then
      candidates+=("$s")
    fi
  done
  if [ "${#candidates[@]}" -ne 1 ]; then
    echo "djb-install-latest: ${#candidates[@]} adb devices have $pkg (${candidates[*]:-none}); set ANDROID_SERIAL" >&2
    exit 1
  fi
  serial=${candidates[0]}
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

if [ $# -gt 0 ]; then
  "$api" GET "/repos/$repo/releases/tags/$1" > "$work/release.json"
else
  "$api" GET "/repos/$repo/releases/latest" > "$work/release.json"
fi
tag=$(jq -r .tag_name "$work/release.json")
apk=$(jq -r '[.assets[] | select(.name | endswith(".apk"))][0].name // empty' "$work/release.json")
if [ -z "$apk" ]; then
  echo "djb-install-latest: release $tag has no .apk asset" >&2
  exit 1
fi
for name in "$apk" "$apk.sha256"; do
  url=$(jq -r --arg n "$name" '.assets[] | select(.name == $n) | .browser_download_url' "$work/release.json")
  "$api" --output "$work/$name" GET "$url"
  [ -s "$work/$name" ]
done
(cd "$work" && gsha256sum -c "$apk.sha256")

echo "installing $tag ($apk) on $serial"
adb -s "$serial" install -r "$work/$apk"

state="$HOME/.local/state/plektra-djb"
mkdir -p "$state"
printf '%s %s\n' "$tag" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$state/installed-$serial"
adb -s "$serial" shell dumpsys package "$pkg" | grep -m1 -E 'lastUpdateTime' || true
